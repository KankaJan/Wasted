{
  "manifest_version": 3,
  "name": "Wasted",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Wasted",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
